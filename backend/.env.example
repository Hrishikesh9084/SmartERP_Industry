APP_ENV=development
DATABASE_URL=postgresql+psycopg://<neon-user>:<neon-password>@<neon-host>/neondb?sslmode=require&channel_binding=require
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173

SUPERADMIN_EMAIL=admin@smarterp.local
SUPERADMIN_PASSWORD=ChangeThisAdminPassword123!

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=SMTP not configured
SMTP_FROM=SmartERP <hello@smartERP.com>
SMTP_USE_TLS=false
SMTP_USE_SSL=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

DEV_SHOW_OTP=true
OTP_EXPIRY_MINUTES=10

# Payment providers (keep blank until configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production settings
APP_ENV=development
