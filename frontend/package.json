{
  "name": "smarterp-industry-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "SmartERP Industry cross-platform ERP client",
  "author": "SmartERP",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "desktop:build": "npm run build && electron-builder",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.smarterp.industry",
    "productName": "SmartERP Industry",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "directories": {"output": "release"},
    "win": {"target": ["nsis", "portable"]},
    "mac": {"target": ["dmg", "zip"], "category": "public.app-category.business"},
    "nsis": {"oneClick": false, "perMachine": false}
  }
}
